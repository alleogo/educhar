# ---- Server ----
PORT=8080
# "production" on Vercel: enables secure cookies and strict CORS
NODE_ENV=development

# Public URL of the frontend, used in password-reset emails and the CORS allowlist
# (no trailing slash; comma-separate several origins if needed)
# Local: http://localhost:3000   Production: https://educhar.vercel.app
FRONTEND_URL=

# ---- Database ----
MONGODB_URL=

# ---- Auth ----
JWT_SECRET=
# Required to register an Admin account (admin signup is refused while this is empty)
ADMIN_SECRET=

# ---- Email (Nodemailer SMTP, port 587) ----
MAIL_HOST=
MAIL_USER=
MAIL_PASS=

# ---- Cloudinary ----
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FOLDER_NAME=

# ---- Razorpay ----
RAZORPAY_KEY=
RAZORPAY_SECRET=
# Secret set on the webhook in Razorpay Dashboard -> Settings -> Webhooks
# (URL: https://<your-domain>/api/v1/payment/verifysignature, events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=
